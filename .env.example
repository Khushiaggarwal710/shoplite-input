# Copy to .env and adjust. Every setting has a default.
# Port for `flask run --port` and the Docker image.
SHOPLITE_PORT=5000
# Relative SQLite paths resolve inside instance/. Read-only (for text-to-SQL):
#   sqlite:///file:instance/shoplite.db?mode=ro&uri=true
SHOPLITE_DB_URL=sqlite:///shoplite.db
SHOPLITE_LOG_LEVEL=INFO
SHOPLITE_TOKEN_TTL_HOURS=24
# "fake" keeps stock sync in memory; otherwise the warehouse URL, e.g. http://localhost:5100
SHOPLITE_WAREHOUSE_URL=fake
# Fault switches for incident drills. Leave off unless you are running a drill.
SHOPLITE_FAULT_SLOW_QUERY=off
SHOPLITE_FAULT_GATEWAY_ERRORS=off
SHOPLITE_FAULT_RESERVATION_LEAK=off
